# Maintainer: v6Bv <https://github.com/v6Bv>
pkgname=pinlock
pkgver=0.1.1
pkgrel=1
pkgdesc="Log in and unlock with a PIN typed on a game controller"
arch=('any')
url="https://github.com/v6Bv/pinlock"
license=('MIT')
depends=('python' 'python-evdev' 'polkit' 'systemd')
optdepends=('python-pyqt6: setup app and login screen passkey panel'
            'layer-shell-qt: login screen passkey panel'
            'steam: open Big Picture after unlocking')
install=pinlock.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

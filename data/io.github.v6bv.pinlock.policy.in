<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>pinlock</vendor>
  <vendor_url>https://github.com/v6Bv/pinlock</vendor_url>
  <action id="io.github.v6bv.pinlock.manage">
    <description>Change your controller login PIN</description>
    <message>Authentication is required to change your pinlock PIN</message>
    <icon_name>pinlock</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@BINDIR@/pinlock</annotate>
  </action>
</policyconfig>
